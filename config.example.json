{
  "api": {
    "listen_addr": "127.0.0.1:8080",
    "ws_refresh_interval": 5,
    "ui_conn_limit": 20
  },
  "outbounds": {
    "servers": [
      { "tag": "proxy", "type": "socks5", "address": "127.0.0.1", "port": 9192 }
    ]
  },
  "process_whitelist": [
    "chrome.exe",
    "BigEyesTV.exe"
  ],
  "performance": {
    "buffer_size": 262144,
    "tcp_nodelay": true,
    "tcp_keep_alive": true,
    "keep_alive_period": 15,
    "tcp_linger": -1
  },
  "system": {
    "tproxy_port": 7893,
    "conn_track_gc_interval": 15,
    "conn_track_ttl": 30
  },
  "automatic_route": {
    "enabled": false
  }
}
