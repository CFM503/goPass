{
  "api": {
    "listen_addr": "127.0.0.1:8080"
  },
  "outbounds": {
    "servers": [
      { "tag": "proxy", "type": "socks5", "address": "127.0.0.1", "port": 9192 }
    ]
  },
  "process_whitelist": [
    "chrome.exe",
    "BigEyesTV.exe"
  ],
  "performance": {
    "buffer_size": 262144
  },
  "system": {
    "tproxy_port": 7893,
    "conn_track_gc_interval": 15,
    "conn_track_ttl": 30
  }
}
